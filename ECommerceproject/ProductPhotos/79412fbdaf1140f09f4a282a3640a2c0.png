.grid-formation { flex-grow: 0; flex-shrink: 0; }

.grid-formation-dynamic { flex-grow: 1; flex-shrink: 1; }

.grid-column-1 { flex-basis: 100%; max-width: 100%; }

.grid-column-2 { flex-basis: 50%; max-width: 50%; }

.grid-column-3 { flex-basis: 33.3333%; max-width: 33.3333%; }

.grid-column-4 { flex-basis: 25%; max-width: 25%; }

.grid-column-5 { flex-basis: 20%; max-width: 20%; }

.grid-column-6 { flex-basis: 16.6667%; max-width: 16.6667%; }

.grid-column-7 { flex-basis: 14.2857%; max-width: 14.2857%; }

.grid-column-8 { flex-basis: 12.5%; max-width: 12.5%; }

.grid-column-9 { flex-basis: 11.1111%; max-width: 11.1111%; }

.grid-column-10 { flex-basis: 10%; max-width: 10%; }

.grid-column-11 { flex-basis: 9.09091%; max-width: 9.09091%; }

.grid-column-12 { flex-basis: 8.33333%; max-width: 8.33333%; }

@-webkit-keyframes icon-shimmer {=20
  0% { background-position: -200% 0px; }
  100% { background-position: 200% 0px; }
}

@keyframes icon-shimmer {=20
  0% { background-position: -200% 0px; }
  100% { background-position: 200% 0px; }
}

.shimmer { animation: 1.5s ease-in-out 0s infinite normal none running icon=
-shimmer; background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(1=
81, 181, 181, 0.75) 50%, rgba(255, 255, 255, 0)) 0% 0% / 200% 100% rgb(255,=
 255, 255); border-radius: 2px; }

