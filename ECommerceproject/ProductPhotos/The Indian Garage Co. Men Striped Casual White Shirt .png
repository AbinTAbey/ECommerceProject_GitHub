.grid-formation { flex-grow: 0; flex-shrink: 0; }

.grid-formation-dynamic { flex-grow: 1; flex-shrink: 1; }

.grid-column-1 { flex-basis: 100%; max-width: 100%; }

.grid-column-2 { flex-basis: 50%; max-width: 50%; }

.grid-column-3 { flex-basis: 33.3333%; max-width: 33.3333%; }

.grid-column-4 { flex-basis: 25%; max-width: 25%; }

.grid-column-5 { flex-basis: 20%; max-width: 20%; }

.grid-column-6 { flex-basis: 16.6667%; max-width: 16.6667%; }

