<?xml version="1.0" encoding="utf-8" ?>
<appSettings>
  <!-- Template for local SMTP credentials:
       1. Ensure appSettings.secrets.config exists locally.
       2. Replace PLACEHOLDER_APP_PASSWORD with your actual Google App Password.
       3. Do not commit your real password to Git. -->
  <add key="SmtpPassword" value="PLACEHOLDER_APP_PASSWORD" />
</appSettings>
